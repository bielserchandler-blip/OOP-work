Mylist = []

while True:
   print("1. add element to the list")
   print("2. remove element from the list")
   print("3. replace an element from the list")
   print("4. sort the elements in the list")
   print("5. print the elements in the list")
   print("6. exit")
   choice = input("Enter your choice: ")
   if choice == "1":
       Mylist.append(input("Enter the element you want to add: "))
   elif choice == "2":
       Mylist.remove(input("Enter the element you want to remove: "))
   elif choice == "3":
       new_num = int(input("Enter the new number: "))
       old_num = input("Enter the number you want to change: ")
       index = Mylist.index(old_num)
       Mylist[index] = new_num
   elif choice == "4":
       Mylist.sort()
   elif choice == "5":
       print(Mylist)
   elif choice == "6":
       break
